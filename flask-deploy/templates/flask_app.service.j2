# roles/flask-deploy/templates/flask_app.service.j2
[Unit]
Description=Flask app (Gunicorn)
After=network.target

[Service]
# run the service as your deployment user
User={{ app_user }}
Group={{ app_group | default(app_user) }}

# app working directory and venv
WorkingDirectory={{ app_base_path }}

# (optional) load env vars if you keep a .env next to the app
EnvironmentFile=-{{ app_base_path }}/.env

# start gunicorn from the venv, binding to a host:port and app module
ExecStart={{ venv_path }}/bin/gunicorn \
  --workers {{ app_workers | default(2) }} \
  --bind {{ app_bind | default('0.0.0.0:8000') }} \
  {{ app_module | default('app:app') }}

Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
