[Unit]
Description=Flask app (Gunicorn)
After=network.target

[Service]
User={{ app_user }}
Group={{ app_group | default(app_user) }}
WorkingDirectory={{ app_base_path }}
EnvironmentFile=-{{ app_base_path }}/.env
ExecStart={{ venv_path }}/bin/gunicorn --workers {{ app_workers }} --bind {{ app_bind }} {{ app_module }}
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
EOF